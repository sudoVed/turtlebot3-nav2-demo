Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 40; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Name: START and GOAL
      Enabled: true
      Topic:
        Value: /demo/markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
    - Class: rviz_default_plugins/TF
      Name: Frames (TF)
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.18
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: true
        base_footprint:
          Value: true
        base_link:
          Value: true
        base_scan:
          Value: true
      Value: true
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/Map
      Name: Live SLAM map
      Enabled: true
      Alpha: 0.95
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Update Topic:
        Value: /map_updates
      Color Scheme: map
    - Class: rviz_default_plugins/RobotModel
      Name: TurtleBot3
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
    - Class: rviz_default_plugins/LaserScan
      Name: Laser
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.035
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 80; 70
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Alpha: 0.4
      Color Scheme: costmap
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
      Update Topic:
        Value: /local_costmap/costmap_updates
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Topic:
        Value: /plan
      Color: 40; 220; 255
      Line Style: Billboards
      Line Width: 0.045
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-down map
      Target Frame: map
      Scale: 110.0
      X: 3.0
      Y: 0.0
  Enabled: true
Window Geometry:
  Width: 1100
  Height: 800
